//Player controller script
using UnityEngine;

public class PlayerController : MonoBehaviour {
    public float moveSpeed = 5f;
    public Rigidbody2D rb;
    public Camera cam;
    public GameObject bulletPrefab;
    public Transform firePoint;

    Vector2 movement;
    Vector2 mousePos;

    void Update() {
    
        movement.x = Input.GetAxisRaw("Horizontal");
        movement.y = Input.GetAxisRaw("Vertical");

        
        mousePos = cam.ScreenToWorldPoint(Input.mousePosition);

        if (Input.GetButtonDown("Fire1")) {
            Shoot();
        }
    }

    void FixedUpdate() {
        rb.MovePosition(rb.position + movement * moveSpeed * Time.fixedDeltaTime);

        // Поворот персонажа к мыши
        Vector2 lookDir = mousePos - rb.position;
        float angle = Mathf.Atan2(lookDir.y, lookDir.x) * Mathf.Rad2Deg - 90f;
        rb.rotation = angle;
    }

    void Shoot() {
        Instantiate(bulletPrefab, firePoint.position, firePoint.rotation);
    }
}
//Zombie AI System
using UnityEngine;

public class ZombieAI : MonoBehaviour {
    public float speed = 2f;
    public float detectionRange = 10f;
    private Transform player;

    void Start() {
        player = GameObject.FindGameObjectWithTag("Player").transform;
    }

    void Update() {
        float distance = Vector3.Distance(transform.position, player.position);

        if (distance < detectionRange) {
            transform.position = Vector2.MoveTowards(transform.position, player.position, speed * Time.deltaTime)
            Vector2 direction = player.position - transform.position;
            float angle = Mathf.Atan2(direction.y, direction.x) * Mathf.Rad2Deg;
            transform.rotation = Quaternion.Euler(0, 0, angle);
        }
    }
}
//Task system
using UnityEngine;

public class InventorySystem : MonoBehaviour {
    public int boxesCollected = 0;
    public float weightPenalty = 0.5f; // На сколько замедляется игрок за каждую коробку
    private PlayerController controller;

    void Start() {
        controller = GetComponent<PlayerController>();
    }

    private void OnTriggerEnter2D(Collider2D other) {
        if (other.CompareTag("Box")) {
            CollectBox(other.gameObject);
        }
    }

    void CollectBox(GameObject box) {
        boxesCollected++;
        Destroy(box);
        
        
        controller.moveSpeed -= weightPenalty;
        
        Debug.Log("Коробок собрано: " + boxesCollected + ". Скорость упала!");
    
    }
}
